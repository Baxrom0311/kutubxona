# Django asosiy sozlamalari
SECRET_KEY=django-insecure-almashtiring-productionda-kuchli-kalit-qoying
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,kutubxona.northflank.app
CSRF_TRUSTED_ORIGINS=https://kutubxona.northflank.app
CORS_ALLOWED_ORIGINS=https://kutubxona.vercel.app,http://localhost:3000

# Ma'lumotlar bazasi (Northflank Postgres addon avtomatik beradi)
DATABASE_URL=postgres://user:password@host:5432/kutubxona

# Cloudflare R2 / S3 saqlagich
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=your_r2_access_key
S3_SECRET_KEY=your_r2_secret_key
S3_BUCKET_KITOBLAR=kutubxona-kitoblar
S3_BUCKET_MUQOVALAR=kutubxona-muqovalar
S3_OCHIQ_DOMEN=https://muqovalar.kutubxona.uz
SAQLAGICH=catalog.storage.R2Saqlagich

# Production xavfsizlik sozlamalari
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# DeepSeek AI LLM
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

