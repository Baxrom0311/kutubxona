    "components": {
        "schemas": {
            "BookDetail": {
                "type": "object",
                "description": "Bitta kitobning to'liq ma'lumotlari serializatori.",
                "properties": {
                    "slug": {
                        "oneOf": [
                            {
                                "type": "string",
                                "maxLength": 300,
                                "pattern": "^[-a-zA-Z0-9_]+$"
                            },
                            {
                                "type": "string",
                                "maxLength": 0
                            }
                        ]
                    },
                    "nomi": {
                        "type": "string",
                        "maxLength": 300
                    },
                    "mualliflar": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "readOnly": true
                    },
                    "turi": {
                        "type": "object",
                        "additionalProperties": {},
                        "readOnly": true
                    },
                    "yonalishlar": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": {}
                        },
                        "readOnly": true
                    },
                    "yil": {
                        "type": "integer",
                        "maximum": 9223372036854775807,
                        "minimum": 0,
                        "format": "int64",
                        "nullable": true
                    },
                    "til": {
                        "$ref": "#/components/schemas/TilEnum"
                    },
                    "muqova": {
                        "type": "string",
                        "readOnly": true
                    },
                    "formatlar": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "readOnly": true
                    },
                    "korishlar_soni": {
                        "type": "integer",
                        "maximum": 9223372036854775807,
                        "minimum": 0,
                        "format": "int64"
                    },
                    "tavsif": {
                        "type": "string"
                    },
                    "nashriyot": {
                        "type": "string",
                        "maxLength": 200
                    },
                    "qoshilgan_sana": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "fayllar": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/BookFile"
                        },
                        "readOnly": true
                    }
                },
                "required": [
                    "fayllar",
                    "formatlar",
                    "mualliflar",
                    "muqova",
                    "nomi",
                    "qoshilgan_sana",
                    "turi",
                    "yonalishlar"
                ]
            },
            "BookFile": {
                "type": "object",
                "description": "Kitob raqamli fayli serializatori.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "format": {
                        "$ref": "#/components/schemas/FormatEnum"
                    },
                    "hajm": {
                        "type": "integer",
                        "maximum": 9223372036854775807,
                        "minimum": 0,
                        "format": "int64"
                    },
                    "sahifalar_soni": {
                        "type": "integer",
                        "maximum": 9223372036854775807,
                        "minimum": 0,
                        "format": "int64",
                        "nullable": true
                    }
                },
                "required": [
                    "format",
                    "id"
                ]
            },
            "BookList": {
                "type": "object",
                "description": "Katalogdagi kitoblar ro'yxati serializatori.",
                "properties": {
                    "slug": {
                        "oneOf": [
                            {
                                "type": "string",
                                "maxLength": 300,
                                "pattern": "^[-a-zA-Z0-9_]+$"
                            },
                            {
                                "type": "string",
                                "maxLength": 0
                            }
                        ]
                    },
                    "nomi": {
                        "type": "string",
                        "maxLength": 300
                    },
                    "mualliflar": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "readOnly": true
                    },
                    "turi": {
                        "type": "object",
                        "additionalProperties": {},
                        "readOnly": true
                    },
                    "yonalishlar": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": {}
                        },
                        "readOnly": true
                    },
                    "yil": {
                        "type": "integer",
                        "maximum": 9223372036854775807,
                        "minimum": 0,
                        "format": "int64",
                        "nullable": true
                    },
                    "til": {
                        "$ref": "#/components/schemas/TilEnum"
                    },
                    "muqova": {
                        "type": "string",
                        "readOnly": true
                    },
                    "formatlar": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "readOnly": true
                    },
                    "korishlar_soni": {
                        "type": "integer",
                        "maximum": 9223372036854775807,
                        "minimum": 0,
                        "format": "int64"
                    }
                },
                "required": [
                    "formatlar",
                    "mualliflar",
                    "muqova",
                    "nomi",
                    "turi",
                    "yonalishlar"
                ]
            },
            "ChatMessage": {
                "type": "object",
                "description": "Suhbat xabarlari serializatori.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "rol": {
                        "$ref": "#/components/schemas/RolEnum"
                    },
                    "matn": {
                        "type": "string"
                    },
                    "yaratilgan_sana": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "id",
                    "matn",
                    "rol",
                    "yaratilgan_sana"
                ]
            },
            "ChatRequest": {
                "type": "object",
                "description": "AI chatbotga yuboriladigan xabar formati.",
                "properties": {
                    "xabar": {
                        "type": "string",
                        "maxLength": 2000
                    },
                    "session_id": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true
                    },
                    "tarix": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": {}
                        }
                    }
                },
                "required": [
                    "xabar"
                ]
            },
            "ChatResponse": {
                "type": "object",
                "description": "AI chatbot javobi formati.",
                "properties": {
                    "javob": {
                        "type": "string"
                    },
                    "session_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "tavsiya_etilgan_kitoblar": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TavsiyaKitob"
                        }
                    }
                },
                "required": [
                    "javob",
                    "session_id"
                ]
            },
            "Form": {
                "type": "object",
                "description": "Kitob turi serializatori.",
                "properties": {
                    "slug": {
                        "oneOf": [
                            {
                                "type": "string",
                                "maxLength": 100,
                                "pattern": "^[-a-zA-Z0-9_]+$"
                            },
                            {
                                "type": "string",
                                "maxLength": 0
                            }
                        ]
                    },
                    "nomi": {
                        "type": "object",
                        "additionalProperties": {},
                        "readOnly": true
                    },
                    "kitoblar_soni": {
                        "type": "integer",
                        "readOnly": true,
                        "default": 0
                    }
                },
                "required": [
                    "kitoblar_soni",
                    "nomi"
                ]
            },
            "FormatEnum": {
                "enum": [
                    "pdf",
                    "epub"
                ],
                "type": "string",
                "description": "* `pdf` - PDF\n* `epub` - EPUB"
            },
            "PaginatedBookListList": {
                "type": "object",
                "required": [
                    "count",
                    "results"
                ],
                "properties": {
                    "count": {
                        "type": "integer",
                        "example": 123
                    },
                    "next": {
                        "type": "string",
                        "nullable": true,
                        "format": "uri",
                        "example": "http://api.example.org/accounts/?sahifa=4"
                    },
                    "previous": {
                        "type": "string",
                        "nullable": true,
                        "format": "uri",
                        "example": "http://api.example.org/accounts/?sahifa=2"
                    },
                    "results": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/BookList"
                        }
                    }
                }
            },
            "RolEnum": {
                "enum": [
                    "user",
                    "assistant",
                    "system"
                ],
                "type": "string",
                "description": "* `user` - Foydalanuvchi\n* `assistant` - AI Maslahatchi\n* `system` - Tizim"
            },
            "Subject": {
                "type": "object",
                "description": "Yo'nalish ierarxik serializatori (bolalari bilan).",
                "properties": {
                    "slug": {
                        "oneOf": [
                            {
                                "type": "string",
                                "maxLength": 100,
                                "pattern": "^[-a-zA-Z0-9_]+$"
                            },
                            {
                                "type": "string",
                                "maxLength": 0
                            }
                        ]
                    },
                    "nomi": {
                        "type": "object",
                        "additionalProperties": {},
                        "readOnly": true
                    },
                    "kitoblar_soni": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "bolalar": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": {}
                        },
                        "readOnly": true
                    }
                },
                "required": [
                    "bolalar",
                    "kitoblar_soni",
                    "nomi"
                ]
            },
            "TavsiyaKitob": {
                "type": "object",
                "description": "AI tavsiya etgan kitob qisqacha ma'lumoti.",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "nomi": {
                        "type": "string"
                    }
                },
                "required": [
                    "nomi",
                    "slug"
                ]
            },
            "TilEnum": {
                "enum": [
                    "uz",
                    "ru",
                    "en"
                ],
                "type": "string",
                "description": "* `uz` - O'zbekcha\n* `ru` - Русский\n* `en` - English"
            }
        },
        "securitySchemes": {
            "basicAuth": {
                "type": "http",
                "scheme": "basic"
            },
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "sessionid"
            }
        }
    }
}