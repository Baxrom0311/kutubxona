{
    "openapi": "3.0.3",
    "info": {
        "title": "Elektron Kutubxona API",
        "version": "1.0.0",
        "description": "Maktab va kollej elektron kutubxonasi hamda DeepSeek AI maslahatchisi REST API hujjati"
    },
    "paths": {
        "/api/chat/": {
            "post": {
                "operationId": "chat_create",
                "description": "Foydalanuvchi so'roviga javob beradi va kerakli kitoblarni tavsiya qiladi",
                "summary": "DeepSeek AI kutubxona virtual maslahatchisi",
                "tags": [
                    "chat"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ChatRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/ChatRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/ChatRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    },
                    {
                        "basicAuth": []
                    },
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ChatResponse"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/chat/sessiya/{session_id}/": {
            "get": {
                "operationId": "chat_sessiya_list",
                "description": "Berilgan session_id bo'yicha barcha xabarlar tarixini qaytaradi",
                "summary": "Suhbat sessiyasi tarixini olish",
                "parameters": [
                    {
                        "in": "path",
                        "name": "session_id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "chat"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    },
                    {
                        "basicAuth": []
                    },
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ChatMessage"
                                    }
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/kitoblar/": {
            "get": {
                "operationId": "kitoblar_list",
                "description": "Kitoblar katalogi uchun ochiq API (faqat GET).",
                "parameters": [
                    {
                        "name": "ordering",
                        "required": false,
                        "in": "query",
                        "description": "Which field to use when ordering the results.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "in": "query",
                        "name": "q",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "sahifa",
                        "required": false,
                        "in": "query",
                        "description": "A page number within the paginated result set.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "in": "query",
                        "name": "saralash",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "enum": [
                                    "-korishlar_soni",
                                    "-nomi",
                                    "-qoshilgan_sana",
                                    "-yil",
                                    "korishlar_soni",
                                    "nomi",
                                    "qoshilgan_sana",
                                    "yil"
                                ]
                            }
                        },
                        "description": "Ordering\n\n* `qoshilgan_sana` - Qo'shilgan sana\n* `-qoshilgan_sana` - Qo'shilgan sana (descending)\n* `nomi` - Kitob nomi\n* `-nomi` - Kitob nomi (descending)\n* `korishlar_soni` - Ko'rishlar soni\n* `-korishlar_soni` - Ko'rishlar soni (descending)\n* `yil` - Chiqarilgan yili\n* `-yil` - Chiqarilgan yili (descending)",
                        "explode": false,
                        "style": "form"
                    },
                    {
                        "in": "query",
                        "name": "til",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "in": "query",
                        "name": "turi",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "in": "query",
                        "name": "yil_dan",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "in": "query",
                        "name": "yil_gacha",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "in": "query",
                        "name": "yonalish",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "tags": [
                    "kitoblar"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    },
                    {
                        "basicAuth": []
                    },
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaginatedBookListList"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/kitoblar/{slug}/": {
            "get": {
                "operationId": "kitoblar_retrieve",
